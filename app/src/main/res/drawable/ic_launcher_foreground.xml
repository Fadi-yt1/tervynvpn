    <path android:pathData="M24,70 C30,58 60,46 86,40 C70,48 46,60 30,72 C27,74 24,73 24,70 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="24" android:startY="72" android:endX="86" android:endY="40">
                <item android:offset="0" android:color="#3300E5FF"/>
                <item android:offset="0.5" android:color="#EE00E5FF"/>
                <item android:offset="1" android:color="#FF9CF9FF"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
