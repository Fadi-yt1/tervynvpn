<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tervyn" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tervyn_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Tervyn.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tervyn_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_art</item>
        <item name="postSplashScreenTheme">@style/Theme.Tervyn</item>
    </style>
    <style name="Theme.Tervyn.Dialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
